{
  "name": "alldocs",
  "version": "0.1.0",
  "private": true,
  "description": "AllDocs — privacy-first, browser-based document toolkit",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @alldocs/web dev",
    "dev:web": "pnpm --filter @alldocs/web dev",
    "dev:api": "pnpm --filter @alldocs/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @alldocs/pdf-core test",
    "test:e2e": "pnpm --filter @alldocs/web test:e2e",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}

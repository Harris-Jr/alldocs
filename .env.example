# ============================================================
# AllDocs — environment variables (copy to .env for local dev)
# ============================================================

# ---- Web (apps/web) ----
# Public base URL used for canonical/OG tags + sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser reaches the API (compress / PDF↔JPG jobs).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public repo URL used by the "GitHub" / "View on GitHub" links (open source).
NEXT_PUBLIC_REPO_URL=https://github.com/alldocs/alldocs

# ---- API (apps/api) ----
PORT=4000
# CHANGE THIS in production. Used to sign JWTs.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# ---- Redis (API + worker) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- Object storage (API + worker) ----
# Internal endpoint (what services use). In docker-compose this is minio:9000.
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-reachable endpoint for signed upload/download URLs.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=alldocs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO needs path-style addressing; real AWS S3 can set this to false.
S3_FORCE_PATH_STYLE=true

# ---- Limits ----
MAX_UPLOAD_BYTES=104857600      # 100 MB (free tier server jobs)
UPLOAD_URL_TTL=900              # 15 min signed upload URLs
DOWNLOAD_URL_TTL=3600           # 1 hour signed download links

# ---- Worker ----
WORKER_CONCURRENCY=4
